ENV=development

# Local dev default (sqlite, zero setup). Swap for your Supabase/Neon
# connection string when ready, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/aegisai
DATABASE_URL=sqlite:///./aegisai.db

# Upstash Redis REST/TCP URL, once the temporal engine needs it
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Point these at wherever each ML service ends up deployed
# (localhost while developing, a HF Space / Render URL later)
AI_TEXT_DETECTOR_URL=http://localhost:8001
SEMANTIC_SIMILARITY_URL=http://localhost:8002
STYLOMETRY_URL=http://localhost:8003
ASR_URL=http://localhost:8004
TEMPORAL_ENGINE_URL=http://localhost:8005

SUSPICION_THRESHOLD=0.65
